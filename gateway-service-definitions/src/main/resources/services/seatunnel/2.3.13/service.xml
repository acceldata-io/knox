<service name="seatunnel" role="SEATUNNEL" version="2.3.13">
    <metadata>
        <context>/seatunnel/</context>
        <description>Apache SeaTunnel Zeta engine Web UI and REST endpoints.</description>
        <shortDesc>SeaTunnel Zeta UI</shortDesc>
        <type>UI</type>
    </metadata>
    <policies>
        <policy role="webappsec"/>
        <policy role="authentication" name="Anonymous"/>
        <policy role="rewrite"/>
        <policy role="identity-assertion"/>
        <policy role="authorization"/>
    </policies>
    <routes>
        <!-- Root + Vite SPA shell (index.html, /favicon.ico) -->
        <route path="/seatunnel">
            <rewrite apply="SEATUNNEL/seatunnel/inbound/root" to="request.url"/>
        </route>
        <route path="/seatunnel/">
            <rewrite apply="SEATUNNEL/seatunnel/inbound/root" to="request.url"/>
        </route>
        <!-- /assets/**, /favicon.ico and every REST endpoint served by the
             Zeta engine's Jetty (/overview, /running-jobs, /finished-jobs,
             /submit-job, /system-monitoring-information, /stop-job, ...) -->
        <route path="/seatunnel/**">
            <rewrite apply="SEATUNNEL/seatunnel/inbound/path" to="request.url"/>
        </route>
        <route path="/seatunnel/**?**">
            <rewrite apply="SEATUNNEL/seatunnel/inbound/path" to="request.url"/>
        </route>
    </routes>
    <dispatch classname="org.apache.knox.gateway.dispatch.PassAllHeadersDispatch"/>
</service>
